# ── AI Gift Recommendation Engine (src/engine) ─────────────────────────────
# Local: these process.env values win. Live (Lovable): .env is not deployed —
# missing keys fall back to src/engine/env.config.ts (keep both in sync).
ENGINE_ENABLED=true
ENGINE_MODE=keyword-search
ENGINE_USE_AI=true
ENGINE_RECOMMENDATION_COUNT=12
ENGINE_PAGE_SIZE=4
ENGINE_MAX_RECOMMENDATION_MS=60000
# ENGINE_SHORTLIST_SIZE=12
ENGINE_FEATURE_VERSION=f3
ENGINE_TRAINING_ENABLED=true
ENGINE_TRAIN_EVERY_MINUTES=30
ENGINE_EVENT_RETENTION_DAYS=180
# Optional: filter which avoid-categories apply (ids). Empty = all defaults
# (candles, perfume, throw-blankets, wallets). See engineConfig.avoidCategories.
# ENGINE_AVOID_CATEGORIES=candles,perfume,throw-blankets,wallets

# Anthropic Claude (primary product suggestions)
ANTHROPIC_API_KEY=
ENGINE_CLAUDE_MODEL=claude-sonnet-4-5-20250929
# Local only: corporate proxy SSL inspection ("self-signed certificate in certificate chain")
# Leave false in env.config.ts for Lovable production.
ENGINE_TLS_INSECURE=false
SUPABASE_SERVICE_ROLE_KEY=

# Optional legacy Lovable gateway (ENGINE_MODE=catalog-hybrid only)
LOVABLE_API_KEY=
LOVABLE_PROJECT_ID=
LOVABLE_GITHUB_REPO_URL=
ENGINE_LOVABLE_MODEL=openai/gpt-6-astra
ENGINE_LOVABLE_GATEWAY_URL=https://ai.gateway.lovable.dev/v1

# Skimlinks affiliate wrapping for non-Amazon BUY THIS links
SKIMLINKS_ENABLED=false
SKIMLINKS_PUBLISHER_ID=
SKIMLINKS_API_KEY=
SKIMLINKS_BASE_URL=https://go.skimresources.com/

# Amazon Associates (primary shop source while Skimlinks unavailable)
AMAZON_ASSOCIATES_ENABLED=true
AMAZON_PARTNER_TAG=rcbuythis20-20
AMAZON_STORE_ID=rcbuythis20-20
AMAZON_MARKETPLACE=www.amazon.com
AMAZON_PREFER_FALLBACK=true
AMAZON_SOURCE_BOOST=0.06
# Optional Product Advertising API credentials
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_HOST=webservices.amazon.com
AMAZON_PAAPI_REGION=us-east-1
